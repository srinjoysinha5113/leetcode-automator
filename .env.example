# Ollama Local LLM Configuration
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=120

# Account Verification (CRITICAL)
# Must match the authenticated LeetCode username exactly before submissions are allowed
EXPECTED_LEETCODE_USERNAME=

# Persistence Database Configuration
# Default: SQLite (portable, zero external dependencies)
# For MySQL: mysql+pymysql://user:password@localhost:3306/leetcode_db
DATABASE_URL=sqlite:///data/leetcode_automator.db

# Submission Safety Controls
# AUTO_SUBMIT=false by default prevents accidental submissions until explicitly enabled
AUTO_SUBMIT=false
MAX_REPAIR_ATTEMPTS=3
MAX_SUBMISSIONS_PER_PROBLEM=3
SUBMISSION_TIMEOUT_SECONDS=120

# Browser Automation (Playwright)
# Set to false to allow visible browser for initial manual login and inspection
BROWSER_HEADLESS=false

# Local Test Execution Limits
TEST_EXECUTION_TIMEOUT_SECONDS=5

# Logging
LOG_LEVEL=INFO
